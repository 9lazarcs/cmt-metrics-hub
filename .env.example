# IBM w3id credentials (only needed if NPS automation session has expired)
IBM_EMAIL=your.email@ibm.com
IBM_PASSWORD=your_password_here

# Phase 1 session — absolute path to engagesupport-extractor/session/state.json
# This lets CMT Metrics Hub reuse the Phase 1 authenticated session automatically.
# Leave blank to use the auto-detected path (../engagesupport-extractor/session/state.json)
SESSION_PATH=

# Directory where Phase 1 drops XLSX files (auto-scanned on startup)
OUTPUT_DIR=/Users/yourname/Library/CloudStorage/OneDrive-IBM/Metrics

PORT=3001
DB_PATH=./data/cmt_metrics.db
HEADLESS=false
# MFA_TIMEOUT_SECONDS controls both the IBM Verify push wait AND all pre-login
# page load patience levels (email field, password field, page loads).
# 180s = 3 minutes — enough time for a slow VPN page load + phone notification.
MFA_TIMEOUT_SECONDS=180
SQUAD_GROUP=NAUS-CFCT-SW-2
CRON_SCHEDULE=0 8 * * *
LOG_LEVEL=info
